{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run typecheck",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"typecheck"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run localization tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"test",
				"--",
				"--run",
				"tests/i18n.test.ts"
			],
			"isBackground": false
		},
		{
			"label": "Check diff integrity",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--check"
			],
			"isBackground": false
		},
		{
			"label": "Run Aurevia dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}