# Required server-only application configuration.
DATABASE_URL=
DIRECT_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Required only for Playwright E2E. Both URLs must target the same local PostgreSQL database ending in _e2e.
AUREVIA_E2E_DATABASE_URL=
AUREVIA_E2E_DIRECT_URL=

# Optional public application configuration.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key only; no browser Supabase client is currently wired.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Test-only loopback HTTP override; never enable in production.
AUREVIA_E2E_ALLOW_HTTP_PROVIDER=

# Required to provision an administrator with `npm run db:seed`.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required server-only Storage configuration when private file workflows are enabled.
# Never expose the service-role key through NEXT_PUBLIC_* or client-side code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only SMTP and support contact configuration.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_EMAIL=aureviainvest@gmail.com
COMPLAINTS_EMAIL=
SUPPORT_PHONE=+1 (210) 504-7697

# Optional server-only verification delivery configuration.
VERIFICATION_CODE_SECRET=
VERIFICATION_EMAIL_API_URL=
VERIFICATION_EMAIL_API_KEY=
VERIFICATION_SMS_API_URL=
VERIFICATION_SMS_API_KEY=
# Set true to require an email/SMS ownership challenge during registration.
REGISTRATION_VERIFICATION_ENABLED=false
PHONE_VERIFICATION_REQUIRED=

# Optional server-only market data. FINNHUB_API_KEY enables Finnhub quotes/history;
# Yahoo Finance is an unofficial fallback. MARKET_DATA_API_URL/KEY are reserved and unused.
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
FINNHUB_API_KEY=

# Optional server-only REAL execution configuration. The registered adapter uses the Individual Trading API model.
# Do not route unrelated customer orders into a single owner account.
REAL_EXECUTION_ENABLED=
ALPACA_PROVIDER=
ALPACA_TRADING_BASE_URL=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_ACCOUNT_ID=
# These compatibility aliases are consumed by configuration but do not enable an Alpaca Broker API adapter.
ALPACA_BROKER_BASE_URL=
ALPACA_BROKER_CLIENT_ID=
ALPACA_BROKER_CLIENT_SECRET=
# Legacy compatibility variables retained for older environment files.
BROKER_PROVIDER=
BROKER_API_URL=
BROKER_API_KEY=
BROKER_ACCOUNT_ID=
BROKER_WEBHOOK_SECRET=

# Optional server-only payment-provider configuration. A real adapter is not included.
PAYMENT_PROVIDER=
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional application runtime configuration.
PORT=
MARKET_TICK_MS=

# Required by the Vercel once-per-minute simulated market cron job.
CRON_SECRET=

# Required only for the local PostgreSQL service in docker-compose.yml.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
